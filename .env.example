# autoresearch reuses ml-intern's scripts for notifications and HF publishing,
# so the real secrets live in ml-intern's env file:
#   ~/.claude/skills/ml-intern/.env
# (TG_BOT_TOKEN / TG_CHAT_ID, SLACK_BOT_TOKEN / SLACK_CHANNEL_ID or SLACK_WEBHOOK_URL, HF_TOKEN, HF_USER)
#
# autoresearch-only optional settings:

# Where run dirs are created (default: ~/autoresearch-runs)
AUTORESEARCH_RUNS_DIR=

# Override the default PapersWithCode page size for scripts/pwc_search.sh
PWC_LIMIT=8
